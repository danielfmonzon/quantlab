[Unit]
Description=quantlab equity paper run (gated, submits)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantlab
Group=quantlab
WorkingDirectory=/opt/quantlab
EnvironmentFile=/opt/quantlab/.env
Environment=QUANTLAB_ENV_FILE=/opt/quantlab/.env
ExecStart=/opt/quantlab/.venv/bin/quantlab paper run-all --asset-class us_equity --submit
TimeoutStartSec=30min
MemoryMax=2G
Restart=no
StandardOutput=journal
StandardError=journal
