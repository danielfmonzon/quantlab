[Unit]
Description=quantlab weekly paper-vs-shadow review (report-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantlab
Group=quantlab
WorkingDirectory=/opt/quantlab
EnvironmentFile=/opt/quantlab/.env
Environment=QUANTLAB_ENV_FILE=/opt/quantlab/.env
ExecStart=/opt/quantlab/.venv/bin/quantlab weekly
TimeoutStartSec=30min
MemoryMax=2G
Restart=no
StandardOutput=journal
StandardError=journal
