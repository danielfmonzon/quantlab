# Secrets
.env

# Data & reports (generated; keep the directories via .gitkeep)
data/*
reports/*
!data/.gitkeep
!reports/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data artifacts
*.parquet
*.duckdb

# Netlify CLI link/deploy state. Machine-specific, and `npm run build:public`
# recreates it on every build -- which is exactly why the site ID is pinned on the
# deploy command line instead of being read from here (see frontend/README.md).
frontend/.netlify/

# OS / editor
.DS_Store
